<div id="billboard-custom">
  <div data-billboard-date></div><span id="billboard-text"></span>
</div>

<style>
  /* Yeni özel billboard sınıfı, tema çakışmaz */
  #billboard-custom {
    width: 100%;
    max-width: 1000px;
    height: 100px;
    border: 1.5px solid var(--border);
    border-radius: 5px;
    display: flex;
    align-items: center;       /* Dikey ortala */
    justify-content: center;   /* Yatay ortala */
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
    overflow: hidden;
    background: transparent;   /* Opsiyonel */
    background-color: #f1ede6; 
	position: relative; /* şart */
	overflow: visible;
  }

#billboard-custom [data-billboard-date] {
  position: absolute;
  bottom: 8px;
  right: 12px;

  font-size: 12px !important;
  line-height: 1 !important;

  color: #6b6b6b !important;
  opacity: 0.75 !important;

  display: block !important;
  visibility: visible !important;

  z-index: 9999 !important;
  white-space: nowrap;
  pointer-events: none;
}

  #billboard-text {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-align: center;
    font-size: 2.0em;
    font-weight: 500;
    line-height: 1.3em;
    opacity: 0;
    transition: opacity 0.5s;
    padding: 0;
  }

  #billboard-text.show {
    opacity: 1;
  }

  /* Mobil uyumlu */
  @media (max-width: 480px) {
    #billboard-custom {
      height: 80px;
    }
    #billboard-text {
      font-size: 1.2em;
    }
  }
@media (max-width: 480px) {
  #billboard-custom [data-billboard-date] {
    font-size: 10px !important;
    opacity: 0.45 !important;
    bottom: 6px;
    right: 8px;
  }
}

</style>

<script>
const texts = [
  "Hâlıkınız bir...",
  "Mâlikiniz bir....",
  "Peygamberiniz bir...",
  "Dininiz bir...",
  "Kitabınız bir...",
  "Kıbleniz bir...",
  "Mü'minler ancak kardeştir!"
];

let index = 0;
const textEl = document.getElementById('billboard-text');

function showNext() {
  textEl.classList.remove('show');

  setTimeout(() => {
    textEl.textContent = texts[index];
    textEl.classList.add('show');

    let delay = (texts[index] === "Mü'minler ancak kardeştir!") ? 4000 : 2000;
    index = (index + 1) % texts.length;
    setTimeout(showNext, delay);
  }, 1000);
}

showNext();
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

  const target = document.querySelector("[data-billboard-date]");
  if (!target) return;

  const today = new Date();

  /* -------- Milâdî -------- */
  const miladi = today.toLocaleDateString("tr-TR", {
    day: "numeric",
    month: "long",
    year: "numeric"
  });

  /* -------- Hicrî (SAĞLAM) -------- */
  const hijriFormatter = new Intl.DateTimeFormat(
    "ar-SA-u-ca-islamic-umalqura-nu-latn",
    { day: "numeric", month: "numeric", year: "numeric" }
  );

  const parts = hijriFormatter.formatToParts(today);

  const hDay   = parts.find(p => p.type === "day")?.value;
  const hMonth = parts.find(p => p.type === "month")?.value;
  const hYear  = parts.find(p => p.type === "year")?.value;

  const hicriMonths = [
    "Muharrem","Safer","Rebiülevvel","Rebiülahir",
    "Cemaziyelevvel","Cemaziyelahir","Receb","Şaban",
    "Ramazan","Şevval","Zilkade","Zilhicce"
  ];

  const hicri = `${hDay} ${hicriMonths[hMonth - 1]} ${hYear}`;

  /* -------- Billboard -------- */
  target.textContent = `${miladi} / ${hicri}`;

});
</script>
